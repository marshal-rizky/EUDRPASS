# Copy to .env.local and fill in. Never commit .env.local.

# anvil | amoy
NEXT_PUBLIC_CHAIN=anvil
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Printed by contracts/script/Deploy.s.sol
NEXT_PUBLIC_PLOT_REGISTRY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DELIVERY_LEDGER=0x0000000000000000000000000000000000000000

# Server-only (used by web/app/api/**). Leave empty to use local fallbacks.
PINATA_JWT=
ANTHROPIC_API_KEY=
# Optional, default claude-haiku-5-5
EXTRACT_MODEL=
